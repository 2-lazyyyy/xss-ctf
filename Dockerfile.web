FROM php:8.2-apache

# Copy your CTF web files into the container
COPY public/ /var/www/html/

# Make the queue file writable for Apache
RUN touch /var/www/html/admin_queue.txt && \
    chown www-data:www-data /var/www/html/admin_queue.txt && \
    chmod 666 /var/www/html/admin_queue.txt

# Change Apache to listen on Render's required port (10000)
RUN sed -i 's/Listen 80/Listen 10000/' /etc/apache2/ports.conf && \
    sed -i 's/:80/:10000/' /etc/apache2/sites-enabled/000-default.conf

EXPOSE 10000

CMD ["apache2-foreground"]
